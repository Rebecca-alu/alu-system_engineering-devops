#!/usr/bin/env bash
# Installs HAProxy and sends traffic to web-01 and web-02 using roundrobin

apt-get -y update
apt-get -y install haproxy

cat > /etc/haproxy/haproxy.cfg <<CONFIG
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server 7250-web-01 3.8.48.55:80 check
    server 7250-web-02 3.10.235.40:80 check
CONFIG

echo "ENABLED=1" >> /etc/default/haproxy
service haproxy restart
